@using Atlas.Web.Areas.PurchaseOrder.Models
@model PurchaseOrderCreateVM
<div class="container">
    <h3>Create Purchase Order</h3>
    <form asp-action="Create" method="post" id="poForm">
        <div class="row mb-3">
            <div class="col-md-3">
                <label>PO Number</label>
                <input asp-for="PONumber" class="form-control" />
            </div>
            <div class="col-md-3">
                <label>Vendor</label>
                <select asp-for="VendorId" class="form-control">
                    <!-- Loop ViewBag.Vendors -->
                    <option value="1">Vendor A</option>
                </select>
            </div>
            <div class="col-md-3">
                <label>Order Date</label>
                <input asp-for="OrderDate" type="date" class="form-control" />
            </div>
        </div>

        <h5>Order Items</h5>
        <table class="table table-bordered" id="detailsTable">
            <thead>
                <tr>
                    <th>Variant (SKU)</th>
                    <th>Warehouse</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Discount</th>
                    <th>Tax</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <!-- Dynamic rows will be added here -->
            </tbody>
        </table>
        <button type="button" id="btnAddItem" class="btn btn-success btn-sm mb-3">+ Add Item</button>

        <div class="text-end">
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            <button type="submit" class="btn btn-primary">Save Purchase Order</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let rowIndex = 0;

        document.getElementById('btnAddItem').addEventListener('click', function() {
            const tbody = document.querySelector('#detailsTable tbody');
            const row = `
                <tr>
                    <td>
                        <input name="OrderDetails[${rowIndex}].VariantId" class="form-control" required />
                    </td>
                    <td>
                        <input name="OrderDetails[${rowIndex}].WarehouseId" class="form-control" required />
                    </td>
                    <td>
                        <input name="OrderDetails[${rowIndex}].Quantity" class="form-control qty" type="number" value="1" />
                    </td>
                    <td>
                        <input name="OrderDetails[${rowIndex}].UnitPrice" class="form-control price" type="number" step="0.01" value="0" />
                    </td>
                    <td>
                        <input name="OrderDetails[${rowIndex}].Discount" class="form-control disc" type="number" step="0.01" value="0" />
                    </td>
                    <td>
                        <input name="OrderDetails[${rowIndex}].TaxAmount" class="form-control tax" type="number" step="0.01" value="0" />
                    </td>
                    <td class="line-total">0</td>
                    <td><button type="button" class="btn btn-danger btn-sm btn-remove">X</button></td>
                </tr>`;
            tbody.insertAdjacentHTML('beforeend', row);
            rowIndex++;
        });

        // Xử lý xóa dòng và tính tổng
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('btn-remove')) {
                e.target.closest('tr').remove();
            }
        });

        // Tính Total tự động cho mỗi dòng khi nhập số
        document.addEventListener('input', function(e) {
            if (e.target.classList.contains('qty') || e.target.classList.contains('price') || e.target.classList.contains('disc') || e.target.classList.contains('tax')) {
                const row = e.target.closest('tr');
                const qty = parseFloat(row.querySelector('.qty').value) || 0;
                const price = parseFloat(row.querySelector('.price').value) || 0;
                const disc = parseFloat(row.querySelector('.disc').value) || 0;
                const tax = parseFloat(row.querySelector('.tax').value) || 0;
                
                const total = (qty * price) - disc + tax;
                row.querySelector('.line-total').innerText = total.toLocaleString();
            }
        });
    </script>
}