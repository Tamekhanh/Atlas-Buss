@model IEnumerable<Atlas.Core.Entities.Category>

@{
    ViewData["Title"] = "Category Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Categories</h1>
            <p class="text-muted mb-0">Manage your product categories and classifications.</p>
        </div>
        <a asp-area="Category" asp-controller="Category" asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-lg"></i> Add Category
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 100px;">ID</th>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th class="text-center" style="width: 200px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">#@item.Id</td>
                                    <td>
                                        <span class="fw-bold">@item.CategoryName</span>
                                    </td>
                                    <td>
                                        <span class="text-muted">
                                            @(string.IsNullOrWhiteSpace(item.CategoryDesc) 
                                                ? "No description provided." 
                                                : item.CategoryDesc)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-area="Category" asp-controller="Category" asp-action="Edit" asp-route-id="@item.Id" 
                                               class="btn btn-sm btn-outline-secondary rounded-pill" title="Edit">
                                                Edit
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill" 
                                                    onclick="confirmDelete(@item.Id)" title="Delete">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder2-x display-4 d-block mb-2"></i>
                                    No categories found. Start by creating one!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id) {
            if (confirm('Are you sure you want to delete this category? This action cannot be undone.')) {
                // 1. Generate the URL on the server with a placeholder '0'
                var baseUrl = '@Url.Action("Delete", "Category", new { area = "Category", id = "0" })';
                
                // 2. Replace the '0' with the actual JavaScript 'id' variable
                var finalUrl = baseUrl.replace('0', id);
                
                window.location.href = finalUrl;
            }
        }
    </script>
}