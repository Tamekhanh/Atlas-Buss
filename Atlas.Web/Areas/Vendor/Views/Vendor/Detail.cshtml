@model Atlas.Web.Areas.Vendor.Models.VendorManagementViewModel

@{
	ViewData["Title"] = "Vendor Detail";
	var isCompany = Model?.RegistrationType == Atlas.Web.Areas.Vendor.Models.VendorRegistrationType.Company;
}

<div class="container py-4">
	<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
		<div>
			<p class="text-uppercase text-muted small mb-1">Vendor detail</p>
			<h1 class="h3 mb-1">@(!string.IsNullOrWhiteSpace(Model?.Name) ? Model!.Name : "Vendor detail")</h1>
			<p class="text-muted mb-0">
				@(isCompany ? "Company vendor profile" : "Person vendor profile")
			</p>
		</div>
		<div class="d-flex gap-2">
			<a asp-area="Vendor" asp-controller="Vendor" asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
		</div>
	</div>

	@if (Model == null)
	{
		<div class="alert alert-warning shadow-sm" role="alert">
			Khong tim thay du lieu vendor.
		</div>
	}
	else
	{
		<div class="row g-4">
			<div class="col-lg-4">
				<div class="card shadow-sm border-0 h-100">
					<div class="card-body p-4">
						<div class="d-flex align-items-start justify-content-between mb-4">
							<div>
								<span class="badge @(isCompany ? "text-bg-primary" : "text-bg-success") mb-3">
									@(isCompany ? "Company" : "Person")
								</span>
								<h2 class="h4 mb-1">@Model.Name</h2>
								<p class="text-muted mb-0">@Model.RegistrationType</p>
							</div>
						</div>

						<div class="rounded-3 bg-light p-3 mb-3">
							<div class="text-muted small text-uppercase mb-1">Tax ID</div>
							<div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.TaxId) ? "N/A" : Model.TaxId)</div>
						</div>

						<div class="rounded-3 bg-light p-3 mb-3">
							<div class="text-muted small text-uppercase mb-1">Phone</div>
							<div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.Phone) ? "N/A" : Model.Phone)</div>
						</div>

						<div class="rounded-3 bg-light p-3">
							<div class="text-muted small text-uppercase mb-1">Email</div>
							<div class="fw-semibold text-break">@(string.IsNullOrWhiteSpace(Model.Email) ? "N/A" : Model.Email)</div>
						</div>
					</div>
				</div>
			</div>

			<div class="col-lg-8">
				<div class="card shadow-sm border-0 mb-4">
					<div class="card-body p-4">
						<h2 class="h5 mb-3">Overview</h2>
						<div class="row g-3">
							<div class="col-md-6">
								<div class="border rounded-3 p-3 h-100">
									<div class="text-muted small text-uppercase mb-1">Type</div>
									<div class="fw-semibold">@Model.RegistrationType</div>
								</div>
							</div>
							<div class="col-md-6">
								<div class="border rounded-3 p-3 h-100">
									<div class="text-muted small text-uppercase mb-1">Primary name</div>
									<div class="fw-semibold">@Model.Name</div>
								</div>
							</div>
							<div class="col-md-12">
								<div class="border rounded-3 p-3 h-100">
									<div class="text-muted small text-uppercase mb-1">Address</div>
									<div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.Address) ? "N/A" : Model.Address)</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="card shadow-sm border-0">
					<div class="card-body p-4">
						<h2 class="h5 mb-3">Contact summary</h2>
						<div class="table-responsive">
							<table class="table align-middle mb-0">
								<tbody>
									<tr>
										<th scope="row" class="w-25">Vendor name</th>
										<td>@Model.Name</td>
									</tr>
									<tr>
										<th scope="row">Tax ID</th>
										<td>@(string.IsNullOrWhiteSpace(Model.TaxId) ? "N/A" : Model.TaxId)</td>
									</tr>
									<tr>
										<th scope="row">Phone</th>
										<td>@(string.IsNullOrWhiteSpace(Model.Phone) ? "N/A" : Model.Phone)</td>
									</tr>
									<tr>
										<th scope="row">Email</th>
										<td>@(string.IsNullOrWhiteSpace(Model.Email) ? "N/A" : Model.Email)</td>
									</tr>
									<tr>
										<th scope="row">Address</th>
										<td>@(string.IsNullOrWhiteSpace(Model.Address) ? "N/A" : Model.Address)</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
</div>
