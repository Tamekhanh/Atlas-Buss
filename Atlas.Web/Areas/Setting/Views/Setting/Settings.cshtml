@model Atlas.Web.Areas.Setting.ViewModels.MyCompanyInfoVM
@{
	ViewData["Title"] = "Company Settings";
}

<div class="container-fluid">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h2>Company Information</h2>
		<a asp-area="" asp-page="/Index" class="btn btn-secondary">Back to Home</a>
	</div>

	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success">@TempData["SuccessMessage"]</div>
	}
	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger">@TempData["Error"]</div>
	}

	<div class="card">
		<div class="card-header fw-semibold">
			Company details used on printed bills
		</div>
		<div class="card-body">
			@if (Model.Id == 0)
			{
				<div class="alert alert-info py-2">No company info set yet. Fill in the form to create it.</div>
			}
			else if (ViewBag.HasLogo == true)
			{
				<div class="alert alert-secondary py-2">
					<i class="bi bi-image"></i> A logo is already attached (LogoID: @Model.LogoId). It will be kept on save.
				</div>
			}

			<form asp-action="Settings" method="post">
				@Html.AntiForgeryToken()
				<input type="hidden" asp-for="Id" />
				<input type="hidden" asp-for="LogoId" />

				<div class="row g-3">
					<div class="col-md-6">
						<label asp-for="CompanyName" class="form-label fw-semibold text-muted"></label>
						<input asp-for="CompanyName" class="form-control" />
						<span asp-validation-for="CompanyName" class="text-danger small"></span>
					</div>
					<div class="col-md-3">
						<label asp-for="TaxId" class="form-label fw-semibold text-muted"></label>
						<input asp-for="TaxId" class="form-control" />
					</div>
					<div class="col-md-3">
						<label asp-for="PhoneNumber" class="form-label fw-semibold text-muted"></label>
						<input asp-for="PhoneNumber" class="form-control" />
					</div>
					<div class="col-md-6">
						<label asp-for="Email" class="form-label fw-semibold text-muted"></label>
						<input asp-for="Email" class="form-control" />
						<span asp-validation-for="Email" class="text-danger small"></span>
					</div>
					<div class="col-md-12">
						<label asp-for="Address" class="form-label fw-semibold text-muted"></label>
						<textarea asp-for="Address" class="form-control" rows="2"></textarea>
					</div>
				</div>

				<div class="mt-3 text-end">
					<button type="submit" class="btn btn-primary">
						<i class="bi bi-save"></i> Save
					</button>
				</div>
			</form>
		</div>
	</div>
</div>
