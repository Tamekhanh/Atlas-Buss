@model Atlas.Core.Entities.Party
@{
    ViewData["Title"] = "Chi tiết Đối tác";
}

<div class="container mt-4">
    <h2>Details: @Model.DisplayName</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header bg-light"><strong>Basic Information</strong></div>
                <div class="card-body">
                    <p><strong>Party Type:</strong> @Model.PartyType</p>
                    <p><strong>Tax ID:</strong> @(Model.TaxId ?? "N/A")</p>
                    <p>
                        <strong>Roles:</strong> 
                        @(Model.IsCustomer ? "Customer" : "") 
                        @(Model.IsVendor ? "Vendor" : "")
                    </p>
                    @if(Model.PartyType == "Person")
                    {
                        <p><strong>Full Name:</strong> @Model.LastName @Model.FirstName</p>
                        <p><strong>Date of Birth:</strong> @Model.DoB?.ToString("dd/MM/yyyy")</p>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header bg-light"><strong>Contact & Address</strong></div>
                <div class="card-body">
                    <p><strong>Phone:</strong> @Model.Contact?.Phone</p>
                    <p><strong>Email:</strong> @Model.Contact?.Email</p>
                    <p><strong>Address:</strong> @Model.Address?.Street, @Model.Address?.City, @Model.Address?.State, @Model.Address?.Country</p>
                </div>
            </div>
        </div>
    </div>
    
    <div>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>