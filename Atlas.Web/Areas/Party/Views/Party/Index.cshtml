@model IEnumerable<Atlas.Web.Areas.Party.Models.PartyListViewModel>
@{
    ViewData["Title"] = "Danh sách Đối tác";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Danh sách Đối tác</h2>
        <a asp-action="Create" class="btn btn-primary">Thêm Đối tác mới</a>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>Tên hiển thị</th>
                <th>Phân loại</th>
                <th>Vai trò</th>
                <th>Điện thoại</th>
                <th>Email</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.DisplayName</strong></td>
                    <td>
                        <span class="badge @(item.PartyType == "Company" ? "bg-primary" : "bg-success")">
                            @item.PartyType
                        </span>
                    </td>
                    <td>
                        @if (item.IsCustomer) { <span class="badge bg-info text-dark">Khách hàng</span> }
                        @if (item.IsVendor) { <span class="badge bg-warning text-dark">Nhà cung cấp</span> }
                    </td>
                    <td>@item.Phone</td>
                    <td>@item.Email</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Chi tiết</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>