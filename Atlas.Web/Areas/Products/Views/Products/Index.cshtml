@model IEnumerable<ProductEntity>

@{
    ViewData["Title"] = "Products";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Products</h1>
            <p class="text-muted mb-0">Quản lý sản phẩm và các biến thể (SKU).</p>
        </div>
        <a href="@Url.Content("~/Products/Create")" class="btn btn-primary">Create Product</a>
    </div>

    <div class="search-contain">
        @{
            var q = ViewContext.HttpContext.Request.Query;
            var isActiveQ = q["isActive"].ToString();
            var onSaleQ = q["onSale"].ToString();
        }
        <form asp-area="Products" asp-controller="Product" asp-action="Search" method="get"
              class="d-flex gap-2 mb-3 align-items-center">
            <input type="text" name="searchTerm"
                   value="@(ViewContext.HttpContext.Request.Query["searchTerm"].ToString())" class="form-control"
                   placeholder="Search by name or code" />

            <input type="text" name="category" value="@(ViewContext.HttpContext.Request.Query["category"].ToString())"
                   class="form-control" style="width:220px" placeholder="Search category" />

            <select name="isActive" class="form-select" style="width:140px">
                <option value="" selected="@(string.IsNullOrEmpty(isActiveQ))">All</option>
                <option value="true" selected="@(isActiveQ == "true")">Active</option>
                <option value="false" selected="@(isActiveQ == "false")">Inactive</option>
            </select>

            <select name="onSale" class="form-select" style="width:140px">
                <option value="" selected="@(string.IsNullOrEmpty(onSaleQ))">All</option>
                <option value="true" selected="@(onSaleQ == "true")">On sale</option>
                <option value="false" selected="@(onSaleQ == "false")">Not on sale</option>
            </select>

            <button type="submit" class="btn btn-outline-secondary">Search</button>
        </form>
    </div>

    <div class="table-responsive shadow-sm rounded-3 bg-white">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Code</th>
                    <th class="text-center">Variants</th> <!-- BỔ SUNG: Hiển thị số lượng biến thể -->
                    <th class="text-end">Base Sale Price</th> <!-- ĐỔI TÊN -->
                    <th class="text-end">Base Cost Price</th> <!-- ĐỔI TÊN -->
                    <th>Active</th>
                    <th>On Sale</th>
                    <th>Employee</th>
                    <th>Barcode</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var product in Model)
                    {
                        <tr class="clickable-row" tabindex="0" role="link"
                            data-href="@Url.Content($"~/Products/Detail/{product.Id}")">
                            <td>@product.Id</td>
                            <td><strong>@product.ProductName</strong></td>
                            <td>@product.ProductCode</td>
                            <td class="text-center">
                                <span class="badge rounded-pill bg-info text-dark">
                                    @(product.Variants?.Count ?? 0) SKU
                                </span>
                            </td>
                            <td class="text-end">@product.BaseSalePrice.ToString("N0")</td> <!-- CẬP NHẬT PROPERTY -->
                            <td class="text-end">@product.BaseCostPrice.ToString("N0")</td> <!-- CẬP NHẬT PROPERTY -->
                            <td>
                                <span class="badge @(product.IsActive ? "bg-success" : "bg-secondary")">
                                    @(product.IsActive ? "Yes" : "No")
                                </span>
                            </td>
                            <td>
                                <span class="badge @(product.Onsale ? "bg-warning text-dark" : "bg-secondary")">
                                    @(product.Onsale ? "Yes" : "No")
                                </span>
                            </td>
                            <td>@product.Employee?.FullName</td>
                            <td>
                                <small class="text-muted">@product.Barcode</small>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center py-5 text-muted">Chưa có dữ liệu sản phẩm.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-3">
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
        var query = ViewContext.HttpContext.Request.Query;
        var currentPage = ViewData["CurrentPage"] as int? ?? 1;
        var hasNext = ViewData["HasNext"] as bool? ?? false;
    }
    <div>
        @if (currentPage > 1)
        {
            <a class="btn btn-sm btn-outline-primary me-2" href="@Url.Action(currentAction, "Product", new { area = "Products", page = currentPage - 1, searchTerm = query["searchTerm"].ToString(), category = query["category"].ToString(), isActive = query["isActive"].ToString(), onSale = query["onSale"].ToString() })">&laquo; Previous</a>
        }
        @if (hasNext)
        {
            <a class="btn btn-sm btn-outline-primary" href="@Url.Action(currentAction, "Product", new { area = "Products", page = currentPage + 1, searchTerm = query["searchTerm"].ToString(), category = query["category"].ToString(), isActive = query["isActive"].ToString(), onSale = query["onSale"].ToString() })">Next &raquo;</a>
        }
    </div>
    <div class="text-muted">Page @currentPage</div>
</div>