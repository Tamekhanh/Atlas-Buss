@model IEnumerable<ProductEntity>

@{
    ViewData["Title"] = "Products";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Products</h1>
            <p class="text-muted mb-0">Danh sách sản phẩm lấy trực tiếp từ database.</p>
        </div>
        <a href="@Url.Content("~/Products/Create")" class="btn btn-primary">Create Product</a>
    </div>
    <div class="search-contain">
        @{
            var q = ViewContext.HttpContext.Request.Query;
            var isActiveQ = q["isActive"].ToString();
            var onSaleQ = q["onSale"].ToString();
        }
        <form asp-area="Products" asp-controller="Product" asp-action="Search" method="get"
              class="d-flex gap-2 mb-3 align-items-center">
            <input type="text" name="searchTerm"
                   value="@(ViewContext.HttpContext.Request.Query["searchTerm"].ToString())" class="form-control"
                   placeholder="Search by name or code" />

            <input type="text" name="category" value="@(ViewContext.HttpContext.Request.Query["category"].ToString())"
                   class="form-control" style="width:220px" placeholder="Search category" />

            <select name="isActive" class="form-select" style="width:140px">
                @if (string.IsNullOrEmpty(isActiveQ))
                {
                    <option value="" selected>All</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                }
                else if (isActiveQ == "true")
                {
                    <option value="">All</option>
                    <option value="true" selected>Active</option>
                    <option value="false">Inactive</option>
                }
                else
                {
                    <option value="">All</option>
                    <option value="true">Active</option>
                    <option value="false" selected>Inactive</option>
                }
            </select>

            <select name="onSale" class="form-select" style="width:140px">
                @if (string.IsNullOrEmpty(onSaleQ))
                {
                    <option value="" selected>All</option>
                    <option value="true">On sale</option>
                    <option value="false">Not on sale</option>
                }
                else if (onSaleQ == "true")
                {
                    <option value="">All</option>
                    <option value="true" selected>On sale</option>
                    <option value="false">Not on sale</option>
                }
                else
                {
                    <option value="">All</option>
                    <option value="true">On sale</option>
                    <option value="false" selected>Not on sale</option>
                }
            </select>

            <button type="submit" class="btn btn-outline-secondary">Search</button>
        </form>
    </div>
    <div class="table-responsive shadow-sm rounded-3 bg-white">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Code</th>
                    <th class="text-end">Sale Price</th>
                    <th class="text-end">Cost Price</th>
                    <th>Active</th>
                    <th>On Sale</th>
                    <th>Employee</th>
                    <th>Barcode</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var product in Model)
                    {
                        <tr class="clickable-row" tabindex="0" role="link"
                            data-href="@Url.Content($"~/Products/Detail/{product.Id}")">
                            <td>@product.Id</td>
                            <td>@product.ProductName</td>
                            <td>@product.ProductCode</td>
                            <td class="text-end">@product.SalePrice.ToString("N0")</td>
                            <td class="text-end">@product.CostPrice.ToString("N0")</td>
                            <td>
                                <span class="badge @(product.IsActive ? "bg-success" : "bg-secondary")">
                                    @(product.IsActive ? "Yes" : "No")
                                </span>
                            </td>
                            <td>
                                <span class="badge @(product.Onsale ? "bg-warning text-dark" : "bg-secondary")">
                                    @(product.Onsale ? "Yes" : "No")
                                </span>
                            </td>
                            <td>@product.Employee?.FullName</td>
                            <td>
                                @product.Barcode
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">Chưa có dữ liệu sản phẩm.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>