@model ProductModelView
@using System.Linq
@using Atlas.Core.Entities

@{
    ViewData["Title"] = "Product Detail";
    var canEdit = User.HasClaim("permission", "PRODUCT_CREATE") || User.HasClaim("permission", "PRODUCT_MANAGE");
    var selectedCategoryIds = new HashSet<int>(Model.CategoryIds ?? new List<int>());
    var availableCategories = Model.AvailableCategories ??
Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var selectedCategories = new List<(int Id, string Name)>();

    foreach (var category in availableCategories)
    {
        if (int.TryParse(category.Value, out var categoryId) && selectedCategoryIds.Contains(categoryId))
        {
            selectedCategories.Add((categoryId, category.Text ?? string.Empty));
        }
    }
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Product Detail</h1>
            <p class="text-muted mb-0">Thông tin chi tiết của sản phẩm @Model.ProductName.</p>
        </div>
        <a class="btn btn-outline-dark rounded-pill px-4" href="@Url.Content("~/Products/Index")">Back to list</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (canEdit)
            {
                <form method="post" asp-action="Detail" asp-route-id="@Model.Id" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="UnitId" />
                    <input type="hidden" asp-for="EmployeeId" />

                    <div class="row g-4">
                        <!-- CỘT TRÁI: THÔNG TIN CƠ BẢN -->
                        <div class="col-sm-6">

                            <div class="mt-2" id="imagePreviewContainer"
                                 style="display: @(!string.IsNullOrWhiteSpace(Model.ImageUrl) ? "block" : "none"); width: 100%; aspect-ratio: 1/1; overflow: hidden; border-radius: 4px; background-color: #f8f9fa; border: 1px dashed #ced4da;">

                                <small class="text-muted d-block mb-1">Image Preview:</small>

                                <img id="imagePreview"
                                     src="@(!string.IsNullOrWhiteSpace(Model.ImageUrl) ? $"/file-storage/{Model.ImageUrl}" : "")"
                                     data-original-src="@(!string.IsNullOrWhiteSpace(Model.ImageUrl) ? $"/file-storage/{Model.ImageUrl}" : "")"
                                     alt="Product Image" style="width: 100%; height: 100%; object-fit: contain;" />
                            </div>
                            <input asp-for="ImageFile" type="file" id="imageInput" class="form-control mt-2" accept="image/*" />

                            <input type="hidden" asp-for="ImageUrl" />
                        </div>
                        <div class="col-md-6">
                            <h2 class="h5 mb-3 border-bottom pb-2">Basic Information</h2>
                            <div class="mb-3">
                                <label asp-for="ProductName" class="form-label"></label>
                                <input asp-for="ProductName" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="ProductCode" class="form-label"></label>
                                <input asp-for="ProductCode" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Barcode" class="form-label"></label>
                                <input asp-for="Barcode" class="form-control" />
                            </div>
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label asp-for="BaseSalePrice" class="form-label">Base Sale Price</label>
                                    <input asp-for="BaseSalePrice" class="form-control" />
                                </div>
                                <div class="col-sm-6">
                                    <label asp-for="BaseCostPrice" class="form-label">Base Cost Price</label>
                                    <input asp-for="BaseCostPrice" class="form-control" />
                                </div>
                            </div>
                            <div class="form-check form-switch mt-3">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label"></label>
                            </div>
                            <div class="form-check form-switch mt-2">
                                <input asp-for="Onsale" class="form-check-input" />
                                <label asp-for="Onsale" class="form-check-label"></label>
                            </div>
                        </div>

                        <!-- CỘT PHẢI: CHI TIẾT & CATEGORY -->
                        <div class="col-md-6">
                            <h2 class="h5 mb-3 border-bottom pb-2">Product Details</h2>
                            <div class="mb-3">
                                <label asp-for="ProductDescription" class="form-label"></label>
                                <textarea asp-for="ProductDescription" class="form-control" rows="3"></textarea>
                            </div>
                            <div class="row g-3">
                                <div class="col-sm-4">
                                    <label asp-for="Weight" class="form-label"></label>
                                    <input asp-for="Weight" class="form-control" />
                                </div>
                                <div class="col-sm-4">
                                    <label asp-for="WarrantyPeriod" class="form-label"></label>
                                    <input asp-for="WarrantyPeriod" class="form-control" />
                                </div>
                            </div>
                            <div class="mb-3 mt-3">
                                <label asp-for="Dimensions" class="form-label"></label>
                                <input asp-for="Dimensions" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Manufacturer" class="form-label"></label>
                                <input asp-for="Manufacturer" class="form-control" />
                            </div>

                            <!-- Category Picker (Giữ nguyên logic của bạn) -->
                            <div class="col-12 mt-3">
                                <label class="form-label fw-semibold d-block">Categories</label>
                                <div class="dropdown w-100" id="detail-category-picker">
                                    <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                        Chọn category để gắn vào sản phẩm
                                    </button>
                                    <div class="dropdown-menu w-100 p-2 shadow category-picker-menu">
                                        <div
                                            class="d-flex justify-content-between align-items-center gap-2 border-bottom pb-2">
                                            <span class="fw-semibold small text-muted">Pick categories</span>
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    id="detail-category-picker-close">Close</button>
                                        </div>
                                        <input type="text" class="form-control form-control-sm mb-2"
                                               id="detail-category-search" placeholder="Search category" />
                                        <div class="category-option-list overflow-auto pe-1"
                                             id="detail-category-option-list">
                                            @foreach (var category in availableCategories)
                                            {
                                                if (int.TryParse(category.Value, out var catId))
                                                {
                                                    <button type="button"
                                                            class="dropdown-item category-option @(selectedCategoryIds.Contains(catId) ? "d-none" : "")"
                                                            data-category-id="@catId"
                                                            data-category-name="@category.Text">@category.Text</button>
                                                }
                                            }
                                        </div>
                                        <div class="border-top pt-2 mt-1">
                                            <input asp-for="NewCategoryName" class="form-control form-control-sm"
                                                   placeholder="Create new category..." />
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-2 d-flex flex-wrap gap-2" id="detail-category-tag-container">
                                    @foreach (var category in selectedCategories)
                                    {
                                        <span class="badge rounded-pill text-bg-primary category-tag"
                                              data-category-id="@category.Id">
                                            <span class="category-tag-text">@category.Name</span>
                                            <button type="button"
                                                    class="btn-close btn-close-white ms-2 category-remove"></button>
                                            <input type="hidden" name="CategoryIds" value="@category.Id" />
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- PHẦN QUẢN LÝ BIẾN THỂ (VARIANTS) -->
                    <div class="mt-5">
                        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                            <h2 class="h5 mb-0">Product Variants (SKUs)</h2>
                            <button type="button" class="btn btn-sm btn-success" id="add-variant-btn">+ Add Variant</button>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered align-middle" id="variants-table">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 25%;">SKU</th>
                                        <th style="width: 15%;">Price</th>
                                        <th style="width: 15%;">Cost</th>
                                        <th style="width: 35%;">Attributes</th>
                                        <th style="width: 10%;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Variants.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                <input name="Variants[@i].SKU" value="@Model.Variants[i].SKU"
                                                       class="form-control" required />
                                            </td>
                                            <td>
                                                <input name="Variants[@i].Price" value="@Model.Variants[i].Price"
                                                       class="form-control" type="number" step="0.01" required />
                                            </td>
                                            <td>
                                                <input name="Variants[@i].Cost" value="@Model.Variants[i].Cost"
                                                       class="form-control" type="number" step="0.01" required />
                                            </td>
                                            <td>
                                                <div class="variant-attr-container d-flex flex-wrap gap-1">
                                                    @foreach (var attrId in Model.Variants[i].AttributeValueIds)
                                                    {
                                                        <span class="badge bg-secondary rounded-pill attr-tag">
                                                            @attrId
                                                            <button type="button"
                                                                    class="btn-close btn-close-white ms-1 btn-sm remove-attr"></button>
                                                            <input type="hidden" name="Variants[@i].AttributeValueIds"
                                                                   value="@attrId" />
                                                        </span>
                                                    }
                                                </div>
                                                <!-- Nơi render dropdown chọn attribute cho variant này -->
                                                <select class="form-select form-select-sm mt-2 attr-selector">
                                                    <option value="">+ Add Attribute</option>
                                                    @{
                                                        var attributeTypes = ViewBag.AttributeTypes as IEnumerable<AttributeType>;
                                                    }

                                                    @if (attributeTypes != null)
                                                    {
                                                        foreach (var attrType in attributeTypes)
                                                        {
                                                            // Kiểm tra nếu attrType hoặc attrType.Values bị null thì bỏ qua
                                                            if (attrType == null || attrType.Values == null) continue;

                                                            <optgroup label="@attrType.AttributeName">
                                                                @foreach (var val in attrType.Values)
                                                                {
                                                                    if (val != null)
                                                                    {
                                                                        <option value="@val.Id">@val.Value</option>
                                                                    }
                                                                }
                                                            </optgroup>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <option value="">No attributes available</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="text-center">
                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm remove-variant">Remove</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a class="btn btn-outline-secondary" href="@Url.Content("~/Products/Index")">Cancel</a>
                        <button type="submit" class="btn btn-primary px-5">Save Product & Variants</button>
                    </div>
                </form>
            }
            else
            {
                <!-- VIEW ONLY MODE -->
                <div class="row g-4">
                    <div class="col-md-6">
                        <h2 class="h5 mb-3 border-bottom pb-2">Basic Information</h2>
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Id</dt>
                            <dd class="col-sm-8">@Model.Id</dd>
                            <dt class="col-sm-4">Name</dt>
                            <dd class="col-sm-8">@Model.ProductName</dd>
                            <dt class="col-sm-4">Code</dt>
                            <dd class="col-sm-8">@Model.ProductCode</dd>
                            <dt class="col-sm-4">Barcode</dt>
                            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Barcode) ? "N/A" : Model.Barcode)</dd>
                            <dt class="col-sm-4">Base Sale Price</dt>
                            <dd class="col-sm-8">@Model.BaseSalePrice.ToString("N0")</dd>
                            <dt class="col-sm-4">Base Cost Price</dt>
                            <dd class="col-sm-8">@Model.BaseCostPrice.ToString("N0")</dd>
                            <dt class="col-sm-4">Active</dt>
                            <dd class="col-sm-8">@(Model.IsActive ? "Yes" : "No")</dd>
                            <dt class="col-sm-4">On Sale</dt>
                            <dd class="col-sm-8">@(Model.Onsale ? "Yes" : "No")</dd>
                            <dt class="col-sm-4">Image</dt>
                            <dd class="col-sm-8">
                                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                                {
                                    <a href="/@Model.ImageUrl" target="_blank" class="text-decoration-none">
                                        <img src="/file-storage/@Model.ImageUrl" alt="Product Image"
                                             style="width: 100%; height: 100%; object-fit: cover;" />
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">No image</span>
                                }
                            </dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <h2 class="h5 mb-3 border-bottom pb-2">Product Details</h2>
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Description</dt>
                            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.ProductDescription) ? "N/A" :
                                                                                                                                                                                            Model.ProductDescription)</dd>
                                <dt class="col-sm-4">Weight</dt>
                                <dd class="col-sm-8">@(Model.Weight.HasValue ? Model.Weight.Value.ToString("N2") : "N/A")</dd>
                                <dt class="col-sm-4">Warranty</dt>
                                <dd class="col-sm-8">@(Model.WarrantyPeriod.HasValue ? $"{Model.WarrantyPeriod} months" : "N/A")
                                </dd>
                                <dt class="col-sm-4">Dimensions</dt>
                                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Dimensions) ? "N/A" : Model.Dimensions)
                                </dd>
                                <dt class="col-sm-4">Manufacturer</dt>
                                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Manufacturer) ? "N/A" :
                                                                                                                                                                                                                Model.Manufacturer)</dd>
                                </dl>
                                <h3 class="h6 mt-4 mb-2">Categories</h3>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var category in selectedCategories)
                                    {
                                        <span class="badge rounded-pill text-bg-primary">@category.Name</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- HIỂN THỊ BẢNG BIẾN THỂ (READ-ONLY) -->
                        <div class="mt-5">
                            <h2 class="h5 mb-3 border-bottom pb-2">Variants List</h2>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>SKU</th>
                                            <th class="text-end">Price</th>
                                            <th class="text-end">Cost</th>
                                            <th>Attributes</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var v in Model.Variants)
                                        {
                                            <tr>
                                                <td><strong>@v.SKU</strong></td>
                                                <td class="text-end">@v.Price.ToString("N0")</td>
                                                <td class="text-end">@v.Cost.ToString("N0")</td>
                                                <td>
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach (var attrId in v.AttributeValueIds)
                                                        {
                                                            <span class="badge bg-secondary rounded-pill">ID: @attrId</span>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (canEdit)
        {
            <!-- JS QUẢN LÝ CATEGORY (Giữ nguyên logic của bạn) -->
            <script>
                (() => {
                    // SỬA LẠI ID CHO KHỚP VỚI HTML (Thêm chữ 'detail-')
                    const picker = document.getElementById('detail-category-picker');
                    const searchInput = document.getElementById('detail-category-search');
                    const optionList = document.getElementById('detail-category-option-list');
                    const tagContainer = document.getElementById('detail-category-tag-container');
                    const closeButton = document.getElementById('detail-category-picker-close');

                    if (!picker || !searchInput || !optionList || !tagContainer) {
                        console.error("Category Picker elements not found!");
                        return;
                    }

                    // Sử dụng một Set để theo dõi các ID đã chọn
                    let selectedIds = new Set(
                        Array.from(tagContainer.querySelectorAll('input[name="CategoryIds"]')).map(input => Number(input.value))
                    );

                    // Hàm cập nhật hiển thị danh sách option
                    const refreshOptions = () => {
                        const query = searchInput.value.trim().toLowerCase();
                        optionList.querySelectorAll('.category-option').forEach(option => {
                            const id = Number(option.dataset.categoryId);
                            const name = (option.dataset.categoryName || '').toLowerCase();

                            // Ẩn nếu: đã chọn HOẶC không khớp từ khóa tìm kiếm
                            const isSelected = selectedIds.has(id);
                            const matchesQuery = !query || name.includes(query);

                            option.classList.toggle('d-none', isSelected || !matchesQuery);
                        });
                    };

                    // Hàm thêm Tag
                    const addTag = (id, name) => {
                        if (selectedIds.has(id)) return;

                        selectedIds.add(id);

                        const tag = document.createElement('span');
                        tag.className = 'badge rounded-pill text-bg-primary category-tag';
                        tag.dataset.categoryId = id;
                        tag.innerHTML = `
                                                                                                                <span class="category-tag-text">${name}</span>
                                                                                                                <button type="button" class="btn-close btn-close-white ms-2 category-remove" aria-label="Close"></button>
                                                                                                                <input type="hidden" name="CategoryIds" value="${id}" />
                                                                                                            `;

                        // Sự kiện xóa tag
                        tag.querySelector('.category-remove').addEventListener('click', (e) => {
                            e.preventDefault();
                            selectedIds.delete(id);
                            tag.remove();
                            refreshOptions();
                        });

                        tagContainer.appendChild(tag);
                        refreshOptions();

                        // Đóng dropdown sau khi chọn
                        const toggleBtn = picker.querySelector('.dropdown-toggle');
                        bootstrap.Dropdown.getInstance(toggleBtn)?.hide();
                    };

                    // Sự kiện click chọn option
                    optionList.addEventListener('click', (e) => {
                        const option = e.target.closest('.category-option');
                        if (option) {
                            addTag(Number(option.dataset.categoryId), option.dataset.categoryName);
                        }
                    });

                    // Sự kiện tìm kiếm
                    searchInput.addEventListener('input', refreshOptions);

                    // Nút Close thủ công
                    closeButton?.addEventListener('click', (e) => {
                        e.preventDefault();
                        const toggleBtn = picker.querySelector('.dropdown-toggle');
                        bootstrap.Dropdown.getInstance(toggleBtn)?.hide();
                    });

                    // Focus vào ô search khi mở dropdown
                    picker.addEventListener('shown.bs.dropdown', () => {
                        searchInput.focus();
                        refreshOptions();
                    });

                    // Khởi tạo lần đầu
                    refreshOptions();
                })();
            </script>

            <!-- JS QUẢN LÝ VARIANTS -->
            <script>
                (() => {
                    const addBtn = document.getElementById('add-variant-btn');
                    const tableBody = document.querySelector('#variants-table tbody');

                    const createVariantRow = (index, sku = '', price = '', cost = '', attrIds = []) => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                        <td><input name="Variants[${index}].SKU" value="${sku}" class="form-control" required /></td>
                        <td><input name="Variants[${index}].Price" value="${price}" class="form-control" type="number" step="0.01" required /></td>
                        <td><input name="Variants[${index}].Cost" value="${cost}" class="form-control" type="number" step="0.01" required /></td>
                        <td>
                        <div class="variant-attr-container d-flex flex-wrap gap-1">
                        ${attrIds.map(id => `
                        <span class="badge bg-secondary rounded-pill attr-tag">
                        ${id}
                        <button type="button" class="btn-close btn-close-white ms-1 btn-sm remove-attr"></button>
                        <input type="hidden" name="Variants[${index}].AttributeValueIds" value="${id}" />
                        </span>`).join('')}
                        </div>
                        <select class="form-select form-select-sm mt-2 attr-selector">
                         <option value="">+ Add Attribute</option>
                         ${Array.from(document.querySelectorAll('.attr-selector option')).filter(opt => opt.value !== "").map(opt => `<option value="${opt.value}">${opt.text}</option>`).join('')}
                        <!-- Nếu là row mới hoàn toàn, ta copy options từ row đầu tiên hoặc từ ViewBag -->
                        </select>
                         </td>
                        <td class="text-center"><button type="button" class="btn btn-outline-danger btn-sm remove-variant">Remove</button></td>
                        `;
                        return tr;
                    };

                    addBtn?.addEventListener('click', () => {
                        const index = tableBody.querySelectorAll('tr').length;
                        tableBody.appendChild(createVariantRow(index));
                    });

                    tableBody?.addEventListener('click', (e) => {
                        if (e.target.classList.contains('remove-variant')) {
                            e.target.closest('tr').remove();
                            reIndexVariants();
                        }
                        if (e.target.classList.contains('remove-attr')) {
                            const tag = e.target.closest('.attr-tag');
                            tag.remove();
                        }
                    });

                    tableBody?.addEventListener('change', (e) => {
                        if (e.target.classList.contains('attr-selector')) {
                            const val = e.target.value;
                            if (!val) return;
                            const row = e.target.closest('tr');
                            const index = row.rowIndex - 1;
                            const container = row.querySelector('.variant-attr-container');

                            const tag = document.createElement('span');
                            tag.className = 'badge bg-secondary rounded-pill attr-tag';
                            tag.innerHTML = `${val} <button type="button" class="btn-close btn-close-white ms-1 btn-sm remove-attr"></button> <input type="hidden" name="Variants[${index}].AttributeValueIds" value="${val}" />`;

                            tag.querySelector('.remove-attr').addEventListener('click', () => tag.remove());
                            container.appendChild(tag);
                            e.target.value = "";
                        }
                    });

                    const reIndexVariants = () => {
                        tableBody.querySelectorAll('tr').forEach((tr, idx) => {
                            tr.querySelectorAll('input').forEach(input => {
                                const name = input.name;
                                if (name) input.name = name.replace(/Variants\[\d+\]/, `Variants[${idx}]`);
                            });
                        });
                    };
                })();

                document.getElementById('imageInput').addEventListener('change', function (event) {
                    const input = event.target;
                    const file = input.files[0];
                    const previewImg = document.getElementById('imagePreview');
                    const previewContainer = document.getElementById('imagePreviewContainer');

                    if (file) {
                        // -- TRƯỜNG HỢP 1: CÓ CHỌN FILE MỚI --
                        // 1. Tạo URL tạm thời cho preview và gán cho src
                        previewImg.src = URL.createObjectURL(file);
                        // 2. Hiển thị khung chứa ảnh (xử lý trường hợp ban đầu không có ảnh)
                        previewContainer.style.display = 'block';
                    } else {
                        // -- TRƯỜNG HỢP 2: HỦY CHỌN FILE (ẤN CANCEL TRÊN DIALOG) --
                        // Lấy lại đường dẫn ảnh gốc từ thuộc tính data-original-src
                        const originalSrc = previewImg.dataset.originalSrc;

                        if (originalSrc) {
                            // Nếu có ảnh gốc, gán lại để khôi phục
                            previewImg.src = originalSrc;
                            previewContainer.style.display = 'block';
                        } else {
                            // Nếu ban đầu không có ảnh, khi hủy chọn file ta lại ẩn khung đi
                            previewContainer.style.display = 'none';
                            previewImg.src = ''; // Xóa sạch src
                        }
                    }
                });
            </script>
        }