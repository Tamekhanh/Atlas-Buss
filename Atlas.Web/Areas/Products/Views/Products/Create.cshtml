@model ProductModelView
@using System.Linq

@{
    ViewData["Title"] = "Create Product";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Create Product</h1>
            <p class="text-muted mb-0">Form tạo mới sản phẩm với đầy đủ các trường thông tin.</p>
        </div>
        <a asp-area="Products" asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <form asp-area="Products" asp-controller="Product" asp-action="Create" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input asp-for="EmployeeId" type="hidden" />

                @{
                    var selectedCategoryIds = new HashSet<int>(Model.CategoryIds ?? new List<int>());
                    var availableCategories = Model.AvailableCategories ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
                    var selectedCategories = new List<(int Id, string Name)>();

                    foreach (var category in availableCategories)
                    {
                        if (int.TryParse(category.Value, out var categoryId) && selectedCategoryIds.Contains(categoryId))
                        {
                            selectedCategories.Add((categoryId, category.Text));
                        }
                    }
                }

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="ProductName" class="form-label fw-semibold"></label>
                        <input asp-for="ProductName" class="form-control" />
                        <span asp-validation-for="ProductName" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="ProductCode" class="form-label fw-semibold"></label>
                        <input asp-for="ProductCode" class="form-control" />
                        <span asp-validation-for="ProductCode" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="UnitId" class="form-label fw-semibold"></label>
                        <input asp-for="UnitId" class="form-control" type="number" min="1" />
                        <small class="text-muted">Nhap ID don vi tinh trong bang Units (vi du: 1).</small>
                        <span asp-validation-for="UnitId" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold d-block">Categories</label>
                        <div class="dropdown w-100" id="category-picker">
                            <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" aria-expanded="false">
                                Chọn category để gắn vào sản phẩm
                            </button>
                            <div class="dropdown-menu w-100 p-2 shadow category-picker-menu">
                                <div class="d-flex justify-content-between align-items-center gap-2 border-bottom pb-2">
                                    <span class="fw-semibold small text-muted">Pick categories</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="category-picker-close">Close</button>
                                </div>
                                <input type="text" class="form-control form-control-sm mb-2" id="category-search" placeholder="Search category" autocomplete="off" />
                                <div class="category-option-list overflow-auto pe-1" id="category-option-list">
                                    @foreach (var category in availableCategories)
                                    {
                                        var categoryValue = category.Value ?? string.Empty;

                                        if (int.TryParse(categoryValue, out var categoryId))
                                        {
                                            var categoryName = category.Text ?? string.Empty;
                                            var isSelected = selectedCategoryIds.Contains(categoryId);
                                            <button type="button"
                                                    class="dropdown-item category-option @(isSelected ? "d-none" : string.Empty)"
                                                    data-category-id="@categoryId"
                                                    data-category-name="@categoryName">
                                                @categoryName
                                            </button>
                                        }
                                    }
                                </div>
                                <div class="border-top pt-2 mt-1">
                                    <label asp-for="NewCategoryName" class="form-label fw-semibold small mb-1">Không tìm thấy? Tạo mới ngay tại đây</label>
                                    <input asp-for="NewCategoryName" class="form-control form-control-sm" placeholder="Type a new category name" />
                                    <small class="text-muted d-block mt-1">Kéo xuống cuối dropdown để tạo category mới và gắn trực tiếp vào sản phẩm này.</small>
                                    <span asp-validation-for="NewCategoryName" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-2 d-flex flex-wrap gap-2" id="category-tag-container">
                            @foreach (var category in selectedCategories)
                            {
                                <span class="badge rounded-pill text-bg-primary category-tag" data-category-id="@category.Id">
                                    <span class="category-tag-text">@category.Name</span>
                                    <button type="button" class="btn-close btn-close-white ms-2 category-remove" aria-label="Remove" data-category-id="@category.Id"></button>
                                    <input type="hidden" name="CategoryIds" value="@category.Id" />
                                </span>
                            }
                        </div>
                        <small class="text-muted d-block mt-2">Chạm vào category trong danh sách để thêm tag. Bấm x để xóa tag.</small>
                        <span asp-validation-for="CategoryIds" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="SalePrice" class="form-label fw-semibold"></label>
                        <input asp-for="SalePrice" class="form-control" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="SalePrice" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="CostPrice" class="form-label fw-semibold"></label>
                        <input asp-for="CostPrice" class="form-control" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="CostPrice" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="ImageUrl" class="form-label fw-semibold"></label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Barcode" class="form-label fw-semibold"></label>
                        <input asp-for="Barcode" class="form-control" />
                        <span asp-validation-for="Barcode" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="form-check mt-4 pt-2">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="form-check mt-4 pt-2">
                            <input asp-for="Onsale" class="form-check-input" />
                            <label asp-for="Onsale" class="form-check-label fw-semibold"></label>
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="ProductDescription" class="form-label fw-semibold"></label>
                        <textarea asp-for="ProductDescription" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="ProductDescription" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="Weight" class="form-label fw-semibold"></label>
                        <input asp-for="Weight" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="Weight" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="WarrantyPeriod" class="form-label fw-semibold"></label>
                        <input asp-for="WarrantyPeriod" class="form-control" type="number" min="0" />
                        <span asp-validation-for="WarrantyPeriod" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="Manufacturer" class="form-label fw-semibold"></label>
                        <input asp-for="Manufacturer" class="form-control" />
                        <span asp-validation-for="Manufacturer" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Dimensions" class="form-label fw-semibold"></label>
                        <input asp-for="Dimensions" class="form-control" placeholder="L x W x H" />
                        <span asp-validation-for="Dimensions" class="text-danger"></span>
                    </div>

                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <a asp-area="Products" asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const picker = document.getElementById('category-picker');
            const toggleButton = picker?.querySelector('.dropdown-toggle');
            const closeButton = document.getElementById('category-picker-close');
            const searchInput = document.getElementById('category-search');
            const optionList = document.getElementById('category-option-list');
            const tagContainer = document.getElementById('category-tag-container');
            if (!picker || !toggleButton || !searchInput || !optionList || !tagContainer) {
                return;
            }

            const getDropdown = () => bootstrap.Dropdown.getOrCreateInstance(toggleButton);
            const hideDropdown = () => getDropdown().hide();
            const toggleDropdown = () => getDropdown().toggle();

            const selectedIds = new Set(Array.from(tagContainer.querySelectorAll('input[name="CategoryIds"]')).map(input => Number(input.value)));

            const hideOption = (option) => option.classList.add('d-none');
            const showOption = (option) => option.classList.remove('d-none');

            const refreshOptions = () => {
                const query = searchInput.value.trim().toLowerCase();
                Array.from(optionList.querySelectorAll('.category-option')).forEach(option => {
                    const id = Number(option.dataset.categoryId);
                    const name = (option.dataset.categoryName || '').toLowerCase();
                    if (selectedIds.has(id) || (query && !name.includes(query))) {
                        hideOption(option);
                    } else {
                        showOption(option);
                    }
                });
            };

            const addTag = (id, name) => {
                if (selectedIds.has(id)) {
                    return;
                }

                selectedIds.add(id);

                const tag = document.createElement('span');
                tag.className = 'badge rounded-pill text-bg-primary category-tag';
                tag.dataset.categoryId = String(id);
                tag.innerHTML = `
                    <span class="category-tag-text"></span>
                    <button type="button" class="btn-close btn-close-white ms-2 category-remove" aria-label="Remove"></button>
                    <input type="hidden" name="CategoryIds" value="${id}" />
                `;

                tag.querySelector('.category-tag-text').textContent = name;
                tag.querySelector('.category-remove').addEventListener('click', () => removeTag(id));
                tagContainer.appendChild(tag);
                refreshOptions();
                hideDropdown();
            };

            const removeTag = (id) => {
                selectedIds.delete(id);
                const tag = tagContainer.querySelector(`.category-tag[data-category-id="${id}"]`);
                if (tag) {
                    tag.remove();
                }
                refreshOptions();
            };

            optionList.addEventListener('click', (event) => {
                const option = event.target.closest('.category-option');
                if (!option) {
                    return;
                }

                addTag(Number(option.dataset.categoryId), option.dataset.categoryName || option.textContent.trim());
                searchInput.value = '';
                refreshOptions();
            });

            searchInput.addEventListener('input', refreshOptions);

            toggleButton.addEventListener('click', (event) => {
                event.preventDefault();
                event.stopPropagation();
                toggleDropdown();
            });

            closeButton?.addEventListener('click', (event) => {
                event.preventDefault();
                hideDropdown();
            });

            tagContainer.addEventListener('click', (event) => {
                const removeButton = event.target.closest('.category-remove');
                if (!removeButton) {
                    return;
                }

                removeTag(Number(removeButton.dataset.categoryId));
            });

            picker.addEventListener('shown.bs.dropdown', () => {
                searchInput.focus();
                refreshOptions();
            });

            picker.addEventListener('hidden.bs.dropdown', () => {
                searchInput.value = '';
                refreshOptions();
            });

            refreshOptions();
        })();
    </script>
}