@model IEnumerable<Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Employees</h1>
            <p class="text-muted mb-0">Danh sách nhân viên toàn hệ thống.</p>
        </div>
        @if (User.HasClaim("permission", "HR_MANAGE"))
        {
            <a class="btn btn-primary" data-href="@Url.Content($"~/HRM/Create")">Create Employee</a>
        }
    </div>

    <div class="mb-3">
        <form method="get" asp-area="HRM" asp-controller="HRM" asp-action="Search" class="row g-2">
            <div class="col-md-5">
                <input name="searchTerm" class="form-control" placeholder="Tìm theo tên (Full Name)" value="@ViewContext.HttpContext.Request.Query["searchTerm"]" />
            </div>
            <div class="col-md-3">
                <input name="employeeNumber" class="form-control" placeholder="Employee Number" value="@ViewContext.HttpContext.Request.Query["employeeNumber"]" />
            </div>
            <div class="col-md-2 d-flex">
                <button type="submit" class="btn btn-primary me-2">Search</button>
                <a class="btn btn-outline-secondary" asp-area="HRM" asp-action="Index">Reset</a>
            </div>
        </form>
    </div>

    <div class="table-responsive shadow-sm rounded-3 bg-white">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Employee Number</th>
                    <th>Full Name</th>
                    <th>Date of Birth</th>
                    <th>Address</th>
                    <th>Contact Id</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var employee in Model)
                    {
                        <tr class="clickable-row" tabindex="0" role="link" data-href="@Url.Content($"~/HRM/Detail/{employee.Id}")">
                            <td>@employee.Id</td>
                            <td>@employee.EmployeeNumber</td>
                            <td>@employee.FullName</td>
                            <td>@employee.DoB.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (employee.Address != null)
                                {
                                    @($"{employee.Address.Street}, {employee.Address.City}, {employee.Address.State}, {employee.Address.Country}")
                                }
                                else
                                {
                                    @:N/A
                                }
                            </td>
                            <td>@employee.ContactId</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">Chưa có dữ liệu nhân viên.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>