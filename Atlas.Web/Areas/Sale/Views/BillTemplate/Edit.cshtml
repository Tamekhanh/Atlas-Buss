@using Atlas.Web.Areas.SaleOrder.Models
@model BillTemplateEditVM

@{
	ViewData["Title"] = "Edit Bill Template";
}

<div class="container-fluid">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h2>Edit Bill Template</h2>
		<a asp-controller="BillTemplate" asp-area="Sale" asp-action="Index" class="btn btn-secondary">Back to List</a>
	</div>

	<form asp-controller="BillTemplate" asp-area="Sale" asp-action="Edit" asp-route-id="@Model.Id" method="post">
		@Html.AntiForgeryToken()
		<partial name="_TemplateForm" model="Model" />
	</form>
</div>
