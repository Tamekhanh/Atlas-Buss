@using Atlas.Web.Areas.SaleOrder.Models
@model List<BillTemplateVM>

<div class="container-fluid">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h2>Bill Templates</h2>
		<a asp-controller="BillTemplate" asp-area="Sale" asp-action="Create" class="btn btn-primary btn-sm">+ New Template</a>
	</div>

	<div class="card">
		<div class="card-body">
			<table class="table table-bordered table-sm align-middle">
				<thead>
					<tr>
						<th>#</th>
						<th>Template Name</th>
						<th>Page Size</th>
						<th>Orientation</th>
						<th>Notes</th>
						<th class="text-center">Default</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@if (!Model.Any())
					{
						<tr>
							<td colspan="7" class="text-center text-muted">No bill templates yet.</td>
						</tr>
					}
					else
					{
						foreach (var t in Model)
						{
							<tr>
								<td>@t.Id</td>
								<td>@t.TemplateName<br /><small class="text-muted">@t.Description</small></td>
								<td>@t.PageSize</td>
								<td>@t.Orientation</td>
								<td>
									@if (!string.IsNullOrWhiteSpace(t.HeaderNote))
									{<div><small><strong>Header:</strong> @t.HeaderNote</small></div>}
									@if (!string.IsNullOrWhiteSpace(t.FooterNote))
									{<div><small><strong>Footer:</strong> @t.FooterNote</small></div>}
								</td>
								<td class="text-center">
									@if (t.IsDefault)
									{<span class="badge bg-success">Default</span>}
								</td>
								<td class="text-end">
									<a asp-controller="BillTemplate" asp-area="Sale" asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
									<form asp-controller="BillTemplate" asp-area="Sale" asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline">
										@Html.AntiForgeryToken()
										<button type="submit" class="btn btn-sm btn-outline-danger"
												onclick="return confirm('Delete this template?')">Delete</button>
									</form>
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</div>
</div>
