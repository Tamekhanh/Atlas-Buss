@using Atlas.Web.Areas.SaleOrder.Models
@using System.Text.Json
@model SaleOrderCreateVM

<div class="container-fluid">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h3>Create Sale Order</h3>
		<a asp-action="Index" class="btn btn-secondary">Back to List</a>
	</div>

	<form asp-action="Create" method="post" id="soForm">
		<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

		<div class="row mb-3">
			<div class="col-md-3">
				<label asp-for="OrderNumber" class="form-label"></label>
				<input asp-for="OrderNumber" class="form-control" />
				<span asp-validation-for="OrderNumber" class="text-danger"></span>
			</div>
			<div class="col-md-3">
				<label asp-for="CustomerId" class="form-label">Customer</label>
				<select asp-for="CustomerId" class="form-control">
					<option value="">-- Select customer --</option>
					@foreach (var customer in Model.Customers)
					{
						<option value="@customer.Id">@customer.Id - @customer.DisplayName</option>
					}
				</select>
				<span asp-validation-for="CustomerId" class="text-danger"></span>
			</div>
			<div class="col-md-3">
				<label asp-for="OrderDate" class="form-label"></label>
				<input asp-for="OrderDate" type="date" class="form-control" />
			</div>
		</div>

		<div class="row mb-3">
			<div class="col-md-2">
				<label asp-for="OrderStatusId" class="form-label">Status ID</label>
				<input asp-for="OrderStatusId" class="form-control" />
			</div>
			<div class="col-md-2">
				<label asp-for="CurrencyId" class="form-label">Currency ID</label>
				<input asp-for="CurrencyId" class="form-control" />
			</div>
			<div class="col-md-2">
				<label asp-for="ExchangeRate" class="form-label"></label>
				<input asp-for="ExchangeRate" class="form-control" type="number" step="0.01" />
			</div>
		</div>

		<h5>Order Items</h5>
		<table class="table table-bordered" id="detailsTable">
			<thead>
				<tr>
					<th>Product</th>
					<th>SKU</th>
					<th>Warehouse</th>
					<th>Quantity</th>
					<th>Unit Price</th>
					<th>Discount</th>
					<th>Tax</th>
					<th>Total</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				@if (Model.OrderDetails.Any())
				{
					for (var i = 0; i < Model.OrderDetails.Count; i++)
					{
						var detail = Model.OrderDetails[i];
						<tr>
							<td>
								<input type="hidden" name="OrderDetails.Index" value="@i" />
								<select name="OrderDetails[@i].VariantId" class="form-control variant-select" data-selected-variant="@detail.VariantId">
									<option value="">-- Select SKU --</option>
								</select>
							</td>
							<td class="variant-sku"></td>
							<td>
								<select name="OrderDetails[@i].WarehouseId" class="form-control warehouse-select" required>
									<option value="">-- Select warehouse --</option>
									@foreach (var warehouse in Model.Warehouses)
									{
										if (warehouse.Id == detail.WarehouseId)
										{
											<option value="@warehouse.Id" selected="selected">@warehouse.WarehouseName</option>
										}
										else
										{
											<option value="@warehouse.Id">@warehouse.WarehouseName</option>
										}
									}
								</select>
							</td>
							<td>
								<input name="OrderDetails[@i].Quantity" class="form-control qty" type="number" value="@detail.Quantity" min="1" />
							</td>
							<td>
								<input name="OrderDetails[@i].UnitPrice" class="form-control price" type="number" step="0.01" value="@detail.UnitPrice" min="0" />
							</td>
							<td>
								<input name="OrderDetails[@i].Discount" class="form-control disc" type="number" step="0.01" value="@detail.Discount" min="0" />
							</td>
							<td>
								<input name="OrderDetails[@i].TaxAmount" class="form-control tax" type="number" step="0.01" value="@detail.TaxAmount" min="0" />
							</td>
							<td class="line-total">@(((detail.Quantity * detail.UnitPrice) - detail.Discount + detail.TaxAmount).ToString("N0"))</td>
							<td><button type="button" class="btn btn-danger btn-sm btn-remove">X</button></td>
						</tr>
					}
				}
			</tbody>
		</table>

		<button type="button" id="btnAddItem" class="btn btn-success btn-sm mb-3">+ Add Item</button>

		<div class="text-end">
			<button type="submit" class="btn btn-primary">Save Sale Order</button>
		</div>
	</form>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script>
		const saleCatalog = @Html.Raw(JsonSerializer.Serialize(Model.Products));
		const warehouses = @Html.Raw(JsonSerializer.Serialize(Model.Warehouses));

		function buildVariantOptions(selectedVariantId) {
			const options = ['<option value="">-- Select SKU --</option>'];

			for (const product of saleCatalog) {
				for (const variant of (product.Variants || [])) {
					const selected = variant.Id === selectedVariantId ? ' selected' : '';
					const priceText = variant.VariantPrice !== null && variant.VariantPrice !== undefined ? ` - ${variant.VariantPrice}` : '';
					options.push(`<option value="${variant.Id}" data-product-id="${product.Id}" data-sku="${variant.SKU}" data-price="${variant.VariantPrice ?? ''}"${selected}>${product.ProductName} / ${variant.SKU}${priceText}</option>`);
				}
			}

			return options.join('');
		}

		function buildWarehouseOptions(selectedWarehouseId) {
			const options = ['<option value="">-- Select warehouse --</option>'];
			for (const warehouse of warehouses) {
				const selected = warehouse.Id === selectedWarehouseId ? ' selected' : '';
				options.push(`<option value="${warehouse.Id}"${selected}>${warehouse.WarehouseName}</option>`);
			}
			return options.join('');
		}

		function recalculateRow(row) {
			const qty = parseFloat(row.querySelector('.qty')?.value) || 0;
			const price = parseFloat(row.querySelector('.price')?.value) || 0;
			const disc = parseFloat(row.querySelector('.disc')?.value) || 0;
			const tax = parseFloat(row.querySelector('.tax')?.value) || 0;
			const total = (qty * price) - disc + tax;
			row.querySelector('.line-total').innerText = total.toLocaleString();
		}

		function wireRow(row) {
			const variantSelect = row.querySelector('.variant-select');
			const skuCell = row.querySelector('.variant-sku');

			if (variantSelect) {
				const selectedVariantId = parseInt(variantSelect.dataset.selectedVariant || '0');
				variantSelect.innerHTML = buildVariantOptions(selectedVariantId);

				variantSelect.addEventListener('change', function () {
					const option = this.options[this.selectedIndex];
					const price = option ? parseFloat(option.dataset.price || '0') : 0;
					const sku = option ? option.dataset.sku || '' : '';
					if (!Number.isNaN(price)) {
						row.querySelector('.price').value = price;
					}

					if (skuCell) {
						skuCell.innerText = sku;
					}

					recalculateRow(row);
				});

				const selectedOption = variantSelect.options[variantSelect.selectedIndex];
				if (selectedOption) {
					const price = parseFloat(selectedOption.dataset.price || '0');
					const sku = selectedOption.dataset.sku || '';
					if (!Number.isNaN(price) && price > 0) {
						row.querySelector('.price').value = price;
					}
					if (skuCell) {
						skuCell.innerText = sku;
					}
				}
			}

			recalculateRow(row);
		}

		let rowIndex = new Date().getTime();

		document.getElementById('btnAddItem').addEventListener('click', function () {
			const tbody = document.querySelector('#detailsTable tbody');
			const row = `
				<tr>
					<td>
						<input type="hidden" name="OrderDetails.Index" value="${rowIndex}" />
						<select name="OrderDetails[${rowIndex}].VariantId" class="form-control variant-select" required>
							<option value="">-- Select SKU --</option>
						</select>
					</td>
					<td class="variant-sku"></td>
					<td>
						<select name="OrderDetails[${rowIndex}].WarehouseId" class="form-control warehouse-select" required>
							${buildWarehouseOptions(0)}
						</select>
					</td>
					<td>
						<input name="OrderDetails[${rowIndex}].Quantity" class="form-control qty" type="number" value="1" min="1" />
					</td>
					<td>
						<input name="OrderDetails[${rowIndex}].UnitPrice" class="form-control price" type="number" step="0.01" value="0" min="0" />
					</td>
					<td>
						<input name="OrderDetails[${rowIndex}].Discount" class="form-control disc" type="number" step="0.01" value="0" min="0" />
					</td>
					<td>
						<input name="OrderDetails[${rowIndex}].TaxAmount" class="form-control tax" type="number" step="0.01" value="0" min="0" />
					</td>
					<td class="line-total">0</td>
					<td><button type="button" class="btn btn-danger btn-sm btn-remove">X</button></td>
				</tr>`;

			tbody.insertAdjacentHTML('beforeend', row);
			wireRow(tbody.lastElementChild);
			rowIndex++;
		});

		document.querySelectorAll('#detailsTable tbody tr').forEach(wireRow);

		document.addEventListener('click', function (e) {
			if (e.target.classList.contains('btn-remove')) {
				e.target.closest('tr').remove();
			}
		});

		document.addEventListener('input', function (e) {
			if (e.target.classList.contains('qty') || e.target.classList.contains('price') ||
				e.target.classList.contains('disc') || e.target.classList.contains('tax')) {
				const row = e.target.closest('tr');
				recalculateRow(row);
			}
		});
	</script>
}
