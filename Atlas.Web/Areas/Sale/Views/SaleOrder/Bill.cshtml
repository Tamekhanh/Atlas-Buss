@{
	ViewData["Title"] = "Print Bill";

	var orderId = (int)ViewBag.OrderId;
	var orderNumber = (string)ViewBag.OrderNumber;
	var templates = ViewBag.Templates;
	var defaultTemplateId = (int)ViewBag.DefaultTemplateId;
}

<div class="container-fluid">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h2>Print Bill &mdash; @orderNumber</h2>
		<a asp-action="Details" asp-route-id="@orderId" class="btn btn-secondary">Back to Order</a>
	</div>

	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger">@TempData["Error"]</div>
	}

	<div class="card mb-3">
		<div class="card-body">
			<div class="row g-2 align-items-end">
				<div class="col-md-4">
					<label class="form-label fw-semibold text-muted">Bill Template</label>
					<select id="templateSelect" class="form-select">
						@foreach (var t in templates)
						{
							<option value="@t.Id" selected="@(t.Id == defaultTemplateId)">
								@t.TemplateName@(t.IsDefault ? " (default)" : "")
							</option>
						}
					</select>
				</div>
				<div class="col-md-auto d-flex gap-2">
					<button type="button" id="btnPreview" class="btn btn-outline-primary">Preview</button>
					<button type="button" id="btnPrint" class="btn btn-primary">
						<i class="bi bi-printer"></i> Print to Device
					</button>
					<form id="saveForm" method="post" asp-action="SavePdf" asp-route-id="@orderId">
						@Html.AntiForgeryToken()
						<input type="hidden" name="templateId" id="saveTemplateId" value="@defaultTemplateId" />
						<button type="submit" class="btn btn-success"
								onclick="return confirm('Save this PDF to AtlasStorage and attach to the order?')">
							<i class="bi bi-file-earmark-pdf"></i> Save PDF
						</button>
					</form>
				</div>
			</div>
		</div>
	</div>

	<div class="card">
		<div class="card-header d-flex justify-content-between align-items-center">
			<span class="fw-semibold">PDF Preview</span>
			<small class="text-muted">Generated server-side with the selected template.</small>
		</div>
		<div class="card-body p-0">
			<iframe id="pdfFrame" style="width:100%; height:75vh; border:0;"></iframe>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		(function () {
			const select = document.getElementById('templateSelect');
			const frame = document.getElementById('pdfFrame');
			const saveInput = document.getElementById('saveTemplateId');
			const base = '@Url.Action("PreviewPdf", "SaleOrder", new { area = "Sale", id = orderId })';

			function currentTemplateId() { return select.value; }
			function reloadPreview() {
				const tid = currentTemplateId();
				saveInput.value = tid;
				frame.src = base + (base.indexOf('?') >= 0 ? '&' : '?') + 'templateId=' + encodeURIComponent(tid);
			}

			document.getElementById('btnPreview').addEventListener('click', reloadPreview);
			select.addEventListener('change', reloadPreview);

			document.getElementById('btnPrint').addEventListener('click', function () {
				try { frame.contentWindow.focus(); frame.contentWindow.print(); }
				catch (e) { window.open(base + (base.indexOf('?') >= 0 ? '&' : '?') + 'templateId=' + encodeURIComponent(currentTemplateId()), '_blank'); }
			});

			// Tải thử preview ngay khi mở trang
			reloadPreview();
		})();
	</script>
}
