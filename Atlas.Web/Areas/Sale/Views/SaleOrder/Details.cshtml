@using Atlas.Web.Areas.SaleOrder.Models
@model SaleOrderDetailPageVM

<div class="container-fluid">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h2>Sale Order Details</h2>
		<a asp-action="Index" class="btn btn-secondary">Back to List</a>
	</div>

	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger">@TempData["Error"]</div>
	}

	<div class="card mb-3">
		<div class="card-body">
			<div class="row">
				<div class="col-md-3 mb-2">
					<label class="form-label fw-semibold text-muted">Order Number</label>
					<div class="form-control-plaintext fw-bold">@Model.OrderNumber</div>
				</div>
				<div class="col-md-3 mb-2">
					<label class="form-label fw-semibold text-muted">Order Date</label>
					<div class="form-control-plaintext">@Model.OrderDate.ToString("dd/MM/yyyy")</div>
				</div>
				<div class="col-md-3 mb-2">
					<label class="form-label fw-semibold text-muted">Status</label>
					<div class="form-control-plaintext">
						<span class="badge bg-info">@Model.StatusName</span>
					</div>
				</div>
				<div class="col-md-3 mb-2">
					<label class="form-label fw-semibold text-muted">Customer</label>
					<div class="form-control-plaintext">@Model.CustomerName</div>
				</div>
				<div class="col-md-3 mb-2">
					<label class="form-label fw-semibold text-muted">Employee</label>
					<div class="form-control-plaintext">@Model.EmployeeName</div>
				</div>
				<div class="col-md-3 mb-2">
					<label class="form-label fw-semibold text-muted">Currency</label>
					<div class="form-control-plaintext">@Model.CurrencyCode (Rate: @Model.ExchangeRate.ToString("N4"))</div>
				</div>
			</div>
		</div>
	</div>

	<h5>Order Items</h5>
	<table class="table table-bordered table-striped">
		<thead>
			<tr>
				<th>Product</th>
				<th>SKU</th>
				<th>Warehouse</th>
				<th class="text-end">Quantity</th>
				<th class="text-end">Unit Price</th>
				<th class="text-end">Discount</th>
				<th class="text-end">Tax</th>
				<th class="text-end">Line Total</th>
			</tr>
		</thead>
		<tbody>
			@if (!Model.Lines.Any())
			{
				<tr>
					<td colspan="8" class="text-center text-muted">No items in this order.</td>
				</tr>
			}
			else
			{
				foreach (var line in Model.Lines)
				{
					<tr>
						<td>@line.ProductName</td>
						<td>@line.VariantSKU</td>
						<td>@(string.IsNullOrEmpty(line.WarehouseName) ? line.WarehouseId.ToString() : line.WarehouseName)</td>
						<td class="text-end">@line.Quantity.ToString("N0")</td>
						<td class="text-end">@line.UnitPrice.ToString("N2")</td>
						<td class="text-end">@line.Discount.ToString("N2")</td>
						<td class="text-end">@line.TaxAmount.ToString("N2")</td>
						<td class="text-end fw-semibold">@line.LineTotal.ToString("N2")</td>
					</tr>
				}
			}
		</tbody>
		<tfoot>
			<tr class="fw-semibold">
				<td colspan="4" class="text-end">Subtotal</td>
				<td class="text-end">@Model.SubTotal.ToString("N2")</td>
				<td class="text-end">@Model.TotalDiscount.ToString("N2")</td>
				<td class="text-end">@Model.TotalTax.ToString("N2")</td>
				<td class="text-end">@Model.GrandTotal.ToString("N2")</td>
			</tr>
			<tr class="table-active fw-bold">
				<td colspan="7" class="text-end">Grand Total (@Model.CurrencyCode)</td>
				<td class="text-end">@Model.GrandTotal.ToString("N2")</td>
			</tr>
		</tfoot>
	</table>

	<div class="text-end mt-3">
		<a asp-action="Index" class="btn btn-secondary">Back to List</a>
	</div>
</div>
