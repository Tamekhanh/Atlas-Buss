@model List<AttributeTypeViewModel>
@using System.Linq

@{
    ViewData["Title"] = "Attribute Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Attributes</h1>
            <p class="text-muted mb-0">Manage attribute types (e.g. Color, Size) and their values used by product variants.</p>
        </div>
        <a asp-area="Attributes" asp-controller="Attribute" asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-lg"></i> Add Attribute
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 80px;">ID</th>
                            <th style="width: 25%;">Attribute Name</th>
                            <th style="width: 30%;">Description</th>
                            <th>Values</th>
                            <th class="text-center" style="width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr data-attribute-type-id="@item.Id" data-attribute-name="@item.AttributeName">
                                    <td class="ps-4 text-muted">#@item.Id</td>
                                    <td><span class="fw-bold">@item.AttributeName</span></td>
                                    <td>
                                        <span class="text-muted small">
                                            @(string.IsNullOrWhiteSpace(item.Description) ? "No description provided." : item.Description)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1 attribute-value-list">
                                            @if (item.Values != null && item.Values.Any())
                                            {
                                                foreach (var value in item.Values)
                                                {
                                                    <span class="badge bg-secondary rounded-pill attribute-value-tag" data-value-id="@value.Id">
                                                        @value.Value
                                                        <button type="button"
                                                                class="btn-close btn-close-white ms-1 btn-sm remove-value-btn"
                                                                aria-label="Remove value"
                                                                title="Remove value"></button>
                                                    </span>
                                                }
                                            }
                                        </div>
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm mt-2 add-value-btn"
                                                data-attribute-type-id="@item.Id">
                                            + Add Value
                                        </button>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-area="Attributes" asp-controller="Attribute" asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-secondary rounded-pill" title="Edit">Edit</a>
                                            <form asp-area="Attributes" asp-controller="Attribute" asp-action="Delete" asp-route-id="@item.Id"
                                                  method="post" class="d-inline delete-type-form">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill delete-type-btn"
                                                        title="Delete">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder2-x display-4 d-block mb-2"></i>
                                    No attributes found. Start by creating one!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal thêm nhanh giá trị thuộc tính -->
<div class="modal fade" id="add-value-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header">
                <h5 class="modal-title mb-0">Add Value</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="add-value-form">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="add-value-attribute-type-id" />
                    <div class="mb-0">
                        <label class="form-label">New value for <span class="fw-semibold" id="add-value-attribute-name"></span></label>
                        <input type="text" class="form-control" id="add-value-input" placeholder="e.g. Red, XL, Cotton" autocomplete="off" />
                        <div class="text-danger small mt-1" id="add-value-error"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Value</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Form ẩn gửi DELETE value bằng POST (bảo mật anti-forgery) -->
<form id="delete-value-form" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        (() => {
            const valueModalEl = document.getElementById('add-value-modal');
            const valueModal = window.bootstrap?.Modal ? window.bootstrap.Modal.getOrCreateInstance(valueModalEl) : null;
            const valueForm = document.getElementById('add-value-form');
            const valueInput = document.getElementById('add-value-input');
            const valueTypeName = document.getElementById('add-value-attribute-name');
            const valueTypeInput = document.getElementById('add-value-attribute-type-id');
            const valueError = document.getElementById('add-value-error');

            const getAntiForgeryToken = () => {
                const input = document.querySelector('input[name="__RequestVerificationToken"]');
                return input ? input.value : '';
            };

            const escapeHtml = (str) => {
                const div = document.createElement('div');
                div.textContent = str == null ? '' : String(str);
                return div.innerHTML;
            };

            const createValueTag = (id, value) => {
                const span = document.createElement('span');
                span.className = 'badge bg-secondary rounded-pill attribute-value-tag';
                span.dataset.valueId = id;
                span.innerHTML = `${escapeHtml(value)}<button type="button" class="btn-close btn-close-white ms-1 btn-sm remove-value-btn" aria-label="Remove value" title="Remove value"></button>`;
                return span;
            };

            // Mở modal thêm giá trị
            document.addEventListener('click', (e) => {
                const addBtn = e.target.closest('.add-value-btn');
                if (addBtn) {
                    const row = addBtn.closest('tr');
                    valueTypeInput.value = row.dataset.attributeTypeId;
                    valueTypeName.textContent = row.dataset.attributeName;
                    valueInput.value = '';
                    valueError.textContent = '';
                    valueModal?.show();
                    setTimeout(() => valueInput.focus(), 100);
                }

                const removeBtn = e.target.closest('.remove-value-btn');
                if (removeBtn) {
                    e.preventDefault();
                    const tag = removeBtn.closest('.attribute-value-tag');
                    const valueId = tag?.dataset.valueId;
                    const valueText = tag?.textContent?.trim() ?? '';
                    if (!valueId) return;

                    Swal.fire({
                        title: 'Are you sure?',
                        text: `Remove value "${valueText}"?`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#3085d6',
                        confirmButtonText: 'Yes, remove it!'
                    }).then((result) => {
                        if (!result.isConfirmed) return;

                        fetch('@Url.Action("DeleteValue", "Attribute", new { area = "Attributes" })/' + valueId, {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': getAntiForgeryToken() }
                        })
                        .then(r => r.json())
                        .then(data => {
                            if (data.success) {
                                tag?.remove();
                            } else {
                                Swal.fire('Could not delete', data.message || 'It may be in use by product variants.', 'error');
                            }
                        })
                        .catch(() => Swal.fire('Error', 'Something went wrong.', 'error'));
                    });
                }

                // Xóa cả loại thuộc tính
                const deleteTypeBtn = e.target.closest('.delete-type-btn');
                if (deleteTypeBtn) {
                    e.preventDefault();
                    const form = deleteTypeBtn.closest('form');
                    const row = deleteTypeBtn.closest('tr');
                    const name = row?.dataset.attributeName ?? 'this attribute';
                    Swal.fire({
                        title: 'Are you sure?',
                        text: `Delete "${name}" and all its values? This cannot be undone.`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#3085d6',
                        confirmButtonText: 'Yes, delete it!'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form?.submit();
                        }
                    });
                }
            });

            // Submit thêm giá trị
            valueForm?.addEventListener('submit', (e) => {
                e.preventDefault();
                valueError.textContent = '';

                const value = valueInput.value.trim();
                if (!value) {
                    valueError.textContent = 'Value is required.';
                    return;
                }

                const typeInput = document.querySelector('input[name="Values[0].Value"], #add-value-attribute-type-id');
                if (!valueTypeInput.value) {
                    valueError.textContent = 'Attribute not selected.';
                    return;
                }

                fetch('@Url.Action("CreateValue", "Attribute", new { area = "Attributes" })', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify({ Value: value, AttributeTypeId: Number(valueTypeInput.value) })
                })
                .then(r => r.json())
                .then(data => {
                    if (!data.success) {
                        valueError.textContent = data.message || 'Could not create value.';
                        return;
                    }

                    const row = document.querySelector(`tr[data-attribute-type-id="${data.attributeTypeId}"]`);
                    if (row) {
                        const list = row.querySelector('.attribute-value-list');
                        list?.appendChild(createValueTag(data.id, data.value));
                    }
                    valueModal?.hide();
                })
                .catch(() => {
                    valueError.textContent = 'Something went wrong.';
                });
            });
        })();
    </script>
}
