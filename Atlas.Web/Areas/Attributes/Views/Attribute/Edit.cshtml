@model AttributeTypeViewModel

@{
    ViewData["Title"] = "Edit Attribute";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Edit Attribute</h1>
            <p class="text-muted mb-0">Update the attribute type. Manage its values from the list page.</p>
        </div>
        <a asp-area="Attributes" asp-controller="Attribute" asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <form asp-area="Attributes" asp-controller="Attribute" asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="AttributeName" class="form-label fw-semibold"></label>
                    <input asp-for="AttributeName" class="form-control" />
                    <span asp-validation-for="AttributeName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Current Values</label>
                    <div class="d-flex flex-wrap gap-1 p-2 border rounded-3 bg-light">
                        @if (Model.Values != null && Model.Values.Any())
                        {
                            foreach (var value in Model.Values)
                            {
                                <span class="badge bg-secondary rounded-pill">@value.Value</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">No values yet — add them from the list page.</span>
                        }
                    </div>
                    <small class="text-muted">Values are managed via the list page to keep them consistent across products.</small>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-5">Save Changes</button>
                    <a asp-area="Attributes" asp-controller="Attribute" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
